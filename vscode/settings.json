{
  // Core settings.
  "debug.console.wordWrap": false,
  "editor.insertSpaces": true,
  "editor.quickSuggestions": {
    "other": true,
    "comments": true,
    "strings": true
  },
  "editor.minimap.enabled": false,
  "editor.rulers": [100],
  "editor.tabSize": 4,
  "editor.unicodeHighlight.nonBasicASCII": false,
  "workbench.colorTheme": "Nord",

  // Ignore known large trees for different languages.
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/target/**": true
  },

  // Extensions settings: most.
  "cSpell.language": "en-GB",
  "git.openRepositoryInParentFolders": "always",
  "redhat.telemetry.enabled": false,
  "remote.SSH.configFile": "~/.vscode/remote-ssh-config",
  "todo-tree.tree.autoRefresh": false,

  // Extensions settings: Rust language server.
  "rust-analyzer.completion.autoimport.enable": false,
  "rust-analyzer.imports.merge.glob": false,
  "rust-analyzer.inlayHints.chainingHints.enable": false,
  "rust-analyzer.inlayHints.closingBraceHints.enable": false,
  "rust-analyzer.inlayHints.parameterHints.enable": false,
  "rust-analyzer.inlayHints.renderColons": false,
  "rust-analyzer.inlayHints.typeHints.enable": false,
  "rust-analyzer.lens.enable": false,

  // Per-language settings.
  "[markdown]": {
    "editor.tabSize": 2,
    "editor.wordWrap": "off"
  },
  "[python]": {
    "editor.formatOnType": true
  },

  // Disable the reason I will switch to VSCodium
  "chat.agent.enabled": false,
  "chat.agent.maxRequests": 0,
  "chat.checkpoints.enabled": false,
  "chat.detectParticipant.enabled": false,
  "chat.disableAIFeatures": true,
  "chat.extensionTools.enabled": false,
  "chat.notifyWindowOnConfirmation": "off",
  "chat.tools.terminal.enableAutoApprove": false,
  "remote.SSH.experimental.chat": false,
  "telemetry.feedback.enabled": false,
  "terminal.integrated.initialHint": false,
  "workbench.enableExperiments": false,
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "workbench.settings.enableNaturalLanguageSearch": false,

  "python.analysis.aiCodeActions": {
    "generateDocstring": false,
    "generateSymbol": false,
    "implementAbstractClasses": false
  }
}
